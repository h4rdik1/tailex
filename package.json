{
  "name": "tailex",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Tailor your resume to a job without inventing anything.",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev:server": "npm run dev -w @tailex/server",
    "dev:web": "npm run dev -w @tailex/web",
    "build": "npm run build -w @tailex/web",
    "start": "npm run start -w @tailex/server",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "npm run typecheck --workspaces",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:docker": "docker compose -f compose.dev.yaml run --rm --service-ports=false dev sh -c \"npm ci --no-audit --no-fund && npm run test:coverage\"",
    "image:build": "docker build -t tailex .",
    "image:run": "docker run --rm -p 8081:8080 --read-only --tmpfs /tmp --cap-drop ALL --security-opt no-new-privileges tailex",
    "dev:docker": "docker compose -f compose.dev.yaml run --rm --service-ports dev sh -c \"npm ci --no-audit --no-fund && npm run dev:server\""
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.1",
    "@types/node": "24.19.2",
    "@vitest/coverage-v8": "5.1.1",
    "eslint": "10.15.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "prettier": "3.10.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vitest": "5.1.1"
  }
}

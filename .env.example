# Copy to .env for local overrides. Never put secrets or API keys here:
# users bring their own LLM key in the browser (BYOK).
PORT=8080
NODE_ENV=development
# Optional, Render free tier only: the public health URL the server pings every 15 s to stay awake.
# Leave empty locally.
# KEEP_ALIVE_URL=https://tailex.prjly.org/api/health
